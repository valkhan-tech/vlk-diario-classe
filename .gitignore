# Saída do build do React (public/ guarda só api.php, .htaccess e dev-router.php versionados)
/public/index.html
/public/assets/
# copiados de web/public/ no build (a fonte versionada é web/public/)
/public/*.webmanifest
/public/favicon*
/public/apple-touch-icon.png
/public/icone-*.png
/web/node_modules/
/web/dist/

# API
/api/vendor/
/api/.env
/api/storage/openapi.json
/api/storage/logs/*
!/api/storage/logs/.gitkeep
/api/.phpunit.cache/
/api/.phpunit.result.cache

# Pacotes de entrega
/release/

# Sistema/IDE
.DS_Store
Thumbs.db
.idea/

# Variaveis do docker compose (portas)
/.env
