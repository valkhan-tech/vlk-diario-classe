{
    "name": "cpod/diario-de-classe",
    "description": "API do Diário de Classe (ddc.cpod.com.br)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "monolog/monolog": "^3.13",
        "php-di/php-di": "^7.1",
        "phpmailer/phpmailer": "^7.2",
        "phpoffice/phpspreadsheet": "^5.11",
        "respect/validation": "^2.5",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15",
        "vlucas/phpdotenv": "^5.8",
        "zircote/swagger-php": "^7.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "test:unit": "phpunit --colors=always --testsuite Unit",
        "test:integration": "phpunit --colors=always --testsuite Integration",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4"
    }
}
