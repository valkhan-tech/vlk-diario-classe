# Copie para api/.env e preencha. O .env real nunca vai para o Git nem para o pacote de entrega.

APP_ENV=local
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=America/Sao_Paulo

# Banco principal (em produção: o MySQL da hospedagem)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ddc_dev
DB_USER=
DB_PASS=

# Banco de teste (OBRIGATORIAMENTE terminando em _test: a suíte se recusa a rodar em outro)
DB_NAME_TEST=ddc_test

# Sessão
SESSION_COOKIE=ddc_sessao
SESSION_TTL_MINUTES=720

# E-mail (SMTP): recuperação de senha e convites
SMTP_HOST=
SMTP_PORT=587
# tls (587), ssl (465) ou vazio (sem criptografia, ex.: Mailpit local)
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME="Diário de Classe"
